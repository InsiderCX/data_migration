accounts/*/out/*
!accounts/*/out/.gitkeep
*.xlsx
*.xls
*.pkl

# Clinic / Alchemer files dropped anywhere by mistake
*Pacijenti*.csv
*Joined*.csv
*surveys*.csv

# Python / OS
__pycache__/
*.pyc
.venv/
.DS_Store

# Local credentials
.env
.env.*
!.env.example
